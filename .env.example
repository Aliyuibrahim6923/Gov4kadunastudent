# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Option 1 (default): public key + server secret. Run supabase/schema.sql then supabase/functions.sql.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
KSV_DB_SECRET=a-long-random-secret-whose-sha256-is-stored-in-the-database
# Option 2: service role key instead of the two above (schema.sql only).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_KEY=a-long-random-passphrase-for-the-dashboard
